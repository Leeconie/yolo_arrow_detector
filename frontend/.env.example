# API配置
# 生产环境API基础URL
VITE_API_BASE_URL=/api

# API FOX Mock服务配置
# 是否启用Mock服务（true/false，开发环境默认启用）
VITE_ENABLE_MOCK=true
# API FOX Mock服务Token（从API FOX平台获取，不要提交真实值）
VITE_APIFOX_TOKEN=

# ==================== AI 识别服务（backend/）====================
# 浏览器侧请求前缀。前端所有识别请求走这个前缀，由 Vite 代理转发到下方地址。
# 一般不需要改，保持 /ai-api 即可。
VITE_AI_BACKEND_BASE=/ai-api
# 后端真实地址（仅 Vite 代理使用，运行在 Node 侧，不会暴露给浏览器）
VITE_AI_BACKEND_URL=http://127.0.0.1:8000
