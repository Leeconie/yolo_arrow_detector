{
  "name": "aimeasurearchery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:development": "vite --mode development",
    "dev:with-mock": "run-p dev mock:upload",
    "test": "vite --mode test",
    "test:with-mock": "run-p test mock:upload",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "build:prod": "vite build --mode prod",
    "preview": "vite preview",
    "preview:dev": "vite preview --mode dev",
    "preview:test": "vite preview --mode test",
    "preview:prod": "vite preview --mode prod",
    "mock:upload": "node scripts/mock-upload-server.js",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.config.ts --testNamePattern='integration'",
    "test:performance": "node scripts/performance-test.js",
    "test:security": "pnpm audit --production --audit-level moderate",
    "test:all": "run-p type-check test:unit test:integration test:e2e",
    "build-only": "vite build --mode prod",
    "build:analyze": "vite build --mode prod && echo '构建分析报告已生成: dist/stats.html'",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "dompurify": "^3.3.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.1",
    "fabric": "^5.5.2",
    "lodash-es": "^4.17.22",
    "pinia": "^3.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.26",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.57.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.5.2",
    "@types/jsdom": "^27.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cors": "^2.8.5",
    "eslint": "^9.39.2",
    "eslint-plugin-playwright": "^2.4.1",
    "eslint-plugin-vue": "~10.6.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "markdownlint-cli": "^0.47.0",
    "multer": "^2.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.97.2",
    "sharp": "^0.34.5",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.2"
  }
}